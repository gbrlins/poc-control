# Banco de dados
POSTGRES_USER=poc_control
POSTGRES_PASSWORD=changeme
POSTGRES_DB=poc_control

# Usuário único (seed)
ADMIN_EMAIL=admin@example.com
# Gerado por scripts/hash_password.py. Cole o hash como ele sai do comando, com "$" simples.
# Pitfall específico do Docker Compose real (não do podman-compose): ele interpola "$" como
# referência de variável neste arquivo, apagando silenciosamente o que não reconhece -- lá,
# escreva CADA "$" do hash como "$$". O podman-compose (ex.: SLES) NÃO faz essa interpolação:
# dobrar o "$" nele deixa "$$" literal no container e também quebra o login. Depois de editar,
# confirme com `podman exec <container_api> printenv ADMIN_PASSWORD_HASH` (ou o equivalente em
# docker) que o valor dentro do container bate com o hash original, de qualquer engine.
ADMIN_PASSWORD_HASH=

# Sessão (cookie httpOnly assinado)
SESSION_SECRET=changeme

# IA (usado a partir do Marco 3)
GEMINI_API_KEY=

# Portas publicadas no host
WEB_PORT=8090
API_PORT=8091

# Sincronização de Procedimentos com outra instância do poc-control (tela Procedimentos > Sincronizar
# com servidor) -- baixar/enviar registros selecionados entre "este deploy" e o indicado aqui.
# Deixe tudo em branco pra esconder a funcionalidade (sem efeito colateral nenhum). A senha só é
# usada pelo processo da api pra logar no servidor remoto -- nunca trafega pro navegador.
SYNC_SERVIDOR_URL=
SYNC_SERVIDOR_EMAIL=
SYNC_SERVIDOR_SENHA=
