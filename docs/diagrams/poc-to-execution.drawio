<mxCell id="c13" value="PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c14" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135" y="70" as="sourcePoint"/><mxPoint x="1135" y="1420" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c15" value="Home &gt; &quot;New project&quot; or &quot;Plan&quot; on a row opens /plan&lt;br&gt;inside the app (the planner runs in an iframe). The&lt;br&gt;planner is one HTML file; it saves its state in the&lt;br&gt;browser on every change." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="107" y="96" width="346" height="68" as="geometry"/></mxCell>
<mxCell id="c16" value="GET /api/planner/capabilities (once, no login). The planner&lt;br&gt;turns on server features only if this answers." style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="206" as="sourcePoint"/><mxPoint x="755" y="206" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c17" value="features: hydrate, procedures, execution, history, draft" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="244" as="sourcePoint"/><mxPoint x="375" y="244" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c18" value="Fills in project, products,&lt;br&gt;infrastructure, network,&lt;br&gt;credentials, ports, tests&lt;br&gt;(catalog), summary" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="324" as="sourcePoint"/><mxPoint x="375" y="324" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c19" value="Saves the project (every key&lt;br&gt;stroke). Credentials stay&lt;br&gt;here." style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="390" as="sourcePoint"/><mxPoint x="565" y="390" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c20" value="Nothing is sent to the server by planning. Exports&lt;br&gt;(customer report, SA report, project JSON) are&lt;br&gt;generated in the browser." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="297" y="412" width="346" height="54" as="geometry"/></mxCell>
<mxCell id="c21" value="Chooses a PDF / spreadsheet&lt;br&gt;/ JSON file or pastes text" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="538" as="sourcePoint"/><mxPoint x="375" y="538" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c22" value="POST /api/planner/hydrate (document, language)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="576" as="sourcePoint"/><mxPoint x="755" y="576" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c23" value="Extract project, products&lt;br&gt;and network suggestions&lt;br&gt;(never infrastructure, ports&lt;br&gt;or credentials)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="656" as="sourcePoint"/><mxPoint x="945" y="656" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c24" value="Structured suggestions" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="694" as="sourcePoint"/><mxPoint x="755" y="694" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c25" value="Suggestions (nothing written to the database)" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="732" as="sourcePoint"/><mxPoint x="375" y="732" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c26" value="Reviews and accepts what to&lt;br&gt;apply" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="784" as="sourcePoint"/><mxPoint x="375" y="784" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c27" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="93" y="478" width="944" height="328" as="geometry"/></mxCell>
<mxCell id="c28" value="opt [Import customer document]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="93" y="478" width="192" height="20" as="geometry"/></mxCell>
<mxCell id="c29" value="GET /api/planner/history?ids=... (catalog test ids)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="866" as="sourcePoint"/><mxPoint x="755" y="866" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c30" value="resultados_catalogo: runs, runs without problems, most&lt;br&gt;native fit (anonymous)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="918" as="sourcePoint"/><mxPoint x="1135" y="918" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c31" value="Suggestion per test; the person confirms it" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="956" as="sourcePoint"/><mxPoint x="375" y="956" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c32" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="283" y="820" width="944" height="158" as="geometry"/></mxCell>
<mxCell id="c33" value="opt [History suggestions]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="283" y="820" width="162" height="20" as="geometry"/></mxCell>
<mxCell id="c34" value="&quot;Generate guided draft with&lt;br&gt;AI&quot; on a test" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="1052" as="sourcePoint"/><mxPoint x="375" y="1052" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c35" value="POST /api/planner/procedure-draft (test, customer, scope,&lt;br&gt;screen language)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="1104" as="sourcePoint"/><mxPoint x="755" y="1104" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c36" value="Research the implementation&lt;br&gt;(Google Search), then write&lt;br&gt;the procedure as HTML" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="1170" as="sourcePoint"/><mxPoint x="945" y="1170" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c37" value="Creates a Procedure as DRAFT (AI-generated), with sections,&lt;br&gt;embeddings and English title" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="1222" as="sourcePoint"/><mxPoint x="1135" y="1222" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c38" value="Draft returned; saved in the local library and linked to&lt;br&gt;the test" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="1274" as="sourcePoint"/><mxPoint x="375" y="1274" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c39" value="It stays a draft, invisible to matching, until someone runs it and validates it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="297" y="1296" width="536" height="26" as="geometry"/></mxCell>
<mxCell id="c40" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="93" y="992" width="1134" height="342" as="geometry"/></mxCell>
<mxCell id="c41" value="opt [Guided procedure draft for a test]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="93" y="992" width="246" height="20" as="geometry"/></mxCell>
<mxCell id="c42" value="Next: &quot;Enable execution&quot; turns the plan into a PoC on&lt;br&gt;the server (page 2)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="107" y="1348" width="346" height="40" as="geometry"/></mxCell>
