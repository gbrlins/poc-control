<mxCell id="c7" value="poc-control API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c8" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="70" as="sourcePoint"/><mxPoint x="565" y="2146" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c9" value="Database + files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c10" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="70" as="sourcePoint"/><mxPoint x="755" y="2146" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c11" value="Gemini" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c12" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="70" as="sourcePoint"/><mxPoint x="945" y="2146" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c13" value="Selects items for the day&lt;br&gt;and prints the day script" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="126" as="sourcePoint"/><mxPoint x="375" y="126" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c14" value="GET /api/pocs/&lt;id&gt;/roteiro?i&lt;br&gt;tem_ids=... (language of the&lt;br&gt;screen)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="192" as="sourcePoint"/><mxPoint x="565" y="192" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c15" value="Printable HTML: environment&lt;br&gt;parameters, each item with&lt;br&gt;its criterion and the steps&lt;br&gt;of its linked procedure,&lt;br&gt;translated if needed" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="286" as="sourcePoint"/><mxPoint x="375" y="286" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c16" value="Runs the test, sets status&lt;br&gt;(pending, in progress,&lt;br&gt;completed, blocked, N/A) and&lt;br&gt;result" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="396" as="sourcePoint"/><mxPoint x="375" y="396" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c17" value="PATCH&lt;br&gt;/api/pocs/&lt;id&gt;/itens/&lt;item&gt;&lt;br&gt;(only the fields that&lt;br&gt;changed)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="476" as="sourcePoint"/><mxPoint x="565" y="476" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c18" value="Saves; every status change&lt;br&gt;is kept in the history with&lt;br&gt;its session" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="542" as="sourcePoint"/><mxPoint x="755" y="542" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c19" value="If result, fit or status&lt;br&gt;changed: updates the&lt;br&gt;anonymous results history; a&lt;br&gt;success also refreshes the&lt;br&gt;item embedding" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="636" as="sourcePoint"/><mxPoint x="755" y="636" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c20" value="Adds a dated note (per&lt;br&gt;session) or an attachment&lt;br&gt;(evidence, notes, written&lt;br&gt;steps)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="716" as="sourcePoint"/><mxPoint x="375" y="716" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c21" value="POST .../notas  or  POST&lt;br&gt;.../anexos (file)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="768" as="sourcePoint"/><mxPoint x="565" y="768" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c22" value="Note in the database;&lt;br&gt;attachment on disk" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="820" as="sourcePoint"/><mxPoint x="755" y="820" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c23" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="93" y="308" width="754" height="534" as="geometry"/></mxCell>
<mxCell id="c24" value="loop [for each item during the sessions]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="93" y="308" width="252" height="20" as="geometry"/></mxCell>
<mxCell id="c25" value="&quot;Promote to validated&lt;br&gt;procedure&quot; (text or HTML&lt;br&gt;attachments only)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="930" as="sourcePoint"/><mxPoint x="375" y="930" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c26" value="POST .../anexos/&lt;id&gt;/validar" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="968" as="sourcePoint"/><mxPoint x="565" y="968" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c27" value="New VALIDATED procedure:&lt;br&gt;sections, embeddings,&lt;br&gt;language, English title and&lt;br&gt;translation" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="1048" as="sourcePoint"/><mxPoint x="755" y="1048" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c28" value="From now on similar items in other PoCs match it and come out green." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="107" y="1070" width="536" height="26" as="geometry"/></mxCell>
<mxCell id="c29" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="93" y="856" width="754" height="252" as="geometry"/></mxCell>
<mxCell id="c30" value="opt [An attachment holds a step-by-step that worked]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="93" y="856" width="324" height="20" as="geometry"/></mxCell>
<mxCell id="c31" value="Pastes the session summary&lt;br&gt;produced by another tool (or&lt;br&gt;creates a session by hand)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="1196" as="sourcePoint"/><mxPoint x="375" y="1196" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c32" value="POST .../sessoes/importar" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="1234" as="sourcePoint"/><mxPoint x="565" y="1234" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c33" value="Extract date, participants, resolved points, failed points,&lt;br&gt;next steps (screen language)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="1286" as="sourcePoint"/><mxPoint x="945" y="1286" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c34" value="Session saved with its&lt;br&gt;language tag" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="1338" as="sourcePoint"/><mxPoint x="755" y="1338" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c35" value="&quot;Generate session summary&quot;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="1376" as="sourcePoint"/><mxPoint x="375" y="1376" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c36" value="POST .../sessoes/&lt;id&gt;/resumo" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="1414" as="sourcePoint"/><mxPoint x="565" y="1414" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c37" value="Formal e-mail text in the screen language: what was done,&lt;br&gt;pending, next steps" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="1466" as="sourcePoint"/><mxPoint x="945" y="1466" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c38" value="Text to copy. It is NOT sent&lt;br&gt;anywhere." style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="1518" as="sourcePoint"/><mxPoint x="375" y="1518" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c39" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="93" y="1122" width="944" height="418" as="geometry"/></mxCell>
<mxCell id="c40" value="opt [A session happened]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="93" y="1122" width="156" height="20" as="geometry"/></mxCell>
<mxCell id="c41" value="&quot;Generate executive summary&quot;&lt;br&gt;(edit it if needed)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="1614" as="sourcePoint"/><mxPoint x="375" y="1614" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c42" value="POST /api/pocs/&lt;id&gt;/apresent&lt;br&gt;acao/resumo  then  PATCH to&lt;br&gt;save the edit" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="1680" as="sourcePoint"/><mxPoint x="565" y="1680" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c43" value="Executive summary from the consolidated status (screen&lt;br&gt;language)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="1732" as="sourcePoint"/><mxPoint x="945" y="1732" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c44" value="Saved with its language tag" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="1770" as="sourcePoint"/><mxPoint x="755" y="1770" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c45" value="Opens the reports: status&lt;br&gt;export, presentation, day&lt;br&gt;script" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="1836" as="sourcePoint"/><mxPoint x="375" y="1836" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c46" value="GET /api/pocs/&lt;id&gt;/export,&lt;br&gt;/apresentacao, /roteiro&lt;br&gt;(?lang=)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="1902" as="sourcePoint"/><mxPoint x="565" y="1902" as="targetPoint"/></mxGeometry></mxCell>
