<mxCell id="c11" value="Background task (in the API process)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c12" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="70" as="sourcePoint"/><mxPoint x="945" y="1670" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c13" value="Gemini" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c14" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135" y="70" as="sourcePoint"/><mxPoint x="1135" y="1670" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c15" value="Database + files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c16" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1325" y="70" as="sourcePoint"/><mxPoint x="1325" y="1670" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c17" value="Three ways in: A) Home row &quot;Execute&quot;, B) planner toolbar or Summary &quot;Enable execution&quot;,&lt;br&gt;C) PoCs &gt; New PoC (upload, no planner). A and B create the PoC from a plan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="107" y="96" width="536" height="40" as="geometry"/></mxCell>
<mxCell id="c18" value="Clicks Execute and confirms&lt;br&gt;what will be sent" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="208" as="sourcePoint"/><mxPoint x="375" y="208" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c19" value="Opens /plan?open=&lt;project&gt;&amp;e&lt;br&gt;nable=1 (one-time parameter)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="260" as="sourcePoint"/><mxPoint x="565" y="260" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c20" value="Clicks &quot;Enable execution&quot; and confirms" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="320" as="sourcePoint"/><mxPoint x="565" y="320" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c21" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="93" y="148" width="564" height="194" as="geometry"/></mxCell>
<mxCell id="c22" value="alt [A: Home row &quot;Execute&quot;]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="93" y="148" width="174" height="20" as="geometry"/></mxCell>
<mxCell id="c23" style="endArrow=none;dashed=1;html=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="93" y="278" as="sourcePoint"/><mxPoint x="657" y="278" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c24" value="else [B: planner toolbar / Summary]" style="text;html=1;fontSize=10;fontStyle=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="97" y="279" width="222" height="16" as="geometry"/></mxCell>
<mxCell id="c25" value="Builds the payload:&lt;br&gt;project, products,&lt;br&gt;network, infrastructure&lt;br&gt;and a flat list of tests.&lt;br&gt;Removes credentials,&lt;br&gt;evidence, notes and URLs&lt;br&gt;with secrets." style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="364" as="sourcePoint"/><mxPoint x="565" y="470" as="targetPoint"/><Array as="points"><mxPoint x="715" y="364"/><mxPoint x="715" y="470"/></Array></mxGeometry></mxCell>
<mxCell id="c26" value="POST /api/pocs/importar-&lt;br&gt;planejador (JSON as text)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="514" as="sourcePoint"/><mxPoint x="755" y="514" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c27" value="Creates the PoC (status: extracting, owner = you) and stores the document on disk" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="552" as="sourcePoint"/><mxPoint x="1325" y="552" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c28" value="Schedules processar_poc&lt;br&gt;(language of the screen,&lt;br&gt;your Gemini key)" style="html=1;endArrow=open;endFill=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="618" as="sourcePoint"/><mxPoint x="945" y="618" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c29" value="201 with the PoC id" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="656" as="sourcePoint"/><mxPoint x="565" y="656" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c30" value="postMessage: go to&lt;br&gt;/pocs/&lt;id&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="708" as="sourcePoint"/><mxPoint x="375" y="708" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c31" value="GET /api/pocs/&lt;id&gt; (every 3 s; header X-UI-Lang)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="776" as="sourcePoint"/><mxPoint x="755" y="776" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c32" value="PoC with its items, progress and classification so far" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="814" as="sourcePoint"/><mxPoint x="375" y="814" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c33" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="283" y="730" width="564" height="106" as="geometry"/></mxCell>
<mxCell id="c34" value="loop [while extracting or items still unclassified]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="283" y="730" width="318" height="20" as="geometry"/></mxCell>
<mxCell id="c35" value="Creates items directly: code, title, expected result,&lt;br&gt;catalog id, result, priority, fit; text tagged with the&lt;br&gt;planner's language" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="924" as="sourcePoint"/><mxPoint x="1325" y="924" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c36" value="Records terminal results in the anonymous history&lt;br&gt;(resultados_catalogo)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="976" as="sourcePoint"/><mxPoint x="1325" y="976" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c37" value="No AI call. Items from the planner are not classified:&lt;br&gt;they use &quot;result&quot;, not a traffic light." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="867" y="998" width="346" height="40" as="geometry"/></mxCell>
<mxCell id="c38" value="Extract items (code, title,&lt;br&gt;description, acceptance&lt;br&gt;criterion, category),&lt;br&gt;prerequisites and phases, in&lt;br&gt;the UI language" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="1144" as="sourcePoint"/><mxPoint x="1135" y="1144" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c39" value="Creates items, prerequisites and phases; text tagged with&lt;br&gt;the UI language; category code from the fixed taxonomy" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="1196" as="sourcePoint"/><mxPoint x="1325" y="1196" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c40" value="classificar_pendentes:&lt;br&gt;classifies every new item&lt;br&gt;(page 3)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="1226" as="sourcePoint"/><mxPoint x="945" y="1276" as="targetPoint"/><Array as="points"><mxPoint x="1095" y="1226"/><mxPoint x="1095" y="1276"/></Array></mxGeometry></mxCell>
<mxCell id="c41" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="853" y="850" width="564" height="440" as="geometry"/></mxCell>
<mxCell id="c42" value="alt [JSON has the planner's flat tests list]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="853" y="850" width="276" height="20" as="geometry"/></mxCell>
<mxCell id="c43" style="endArrow=none;dashed=1;html=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="853" y="1046" as="sourcePoint"/><mxPoint x="1417" y="1046" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c44" value="else [PDF, spreadsheet, text or any other JSON]" style="text;html=1;fontSize=10;fontStyle=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="857" y="1047" width="294" height="16" as="geometry"/></mxCell>
<mxCell id="c45" value="PoC status: ready (or error with the reason per document)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="1320" as="sourcePoint"/><mxPoint x="1325" y="1320" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c46" value="Chooses files (nothing is&lt;br&gt;uploaded yet) or pastes&lt;br&gt;text; fills in title and&lt;br&gt;customer" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="1430" as="sourcePoint"/><mxPoint x="375" y="1430" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c47" value="POST /api/pocs (progress bar; header X-UI-Lang). Several&lt;br&gt;files are allowed." style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="1482" as="sourcePoint"/><mxPoint x="755" y="1482" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c48" value="Same background task as&lt;br&gt;above" style="html=1;endArrow=open;endFill=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="1534" as="sourcePoint"/><mxPoint x="945" y="1534" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c49" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="93" y="1342" width="754" height="214" as="geometry"/></mxCell>
<mxCell id="c50" value="opt [C: PoCs &gt; New PoC]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="93" y="1342" width="150" height="20" as="geometry"/></mxCell>
<mxCell id="c51" value="Cancel: the banner button sets a flag the task checks&lt;br&gt;between documents. Restarting the API container&lt;br&gt;interrupts the task: the PoC is marked error and &quot;Try&lt;br&gt;again&quot; re-extracts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="677" y="1570" width="346" height="68" as="geometry"/></mxCell>
