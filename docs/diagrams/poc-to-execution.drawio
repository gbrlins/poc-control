<mxfile host="app.diagrams.net" type="device">
<diagram name="0 Overview" id="page1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="b3" value="&lt;b&gt;1  Plan (planner, in the browser)&lt;/b&gt;&lt;br&gt;Project, products, infrastructure, network, tests from the catalog. Saved only in localStorage. Optional: import the customer document (Gemini suggests the project data) and history suggestions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="270" height="150" as="geometry"/></mxCell>
<mxCell id="b4" value="&lt;b&gt;2  Start the execution&lt;/b&gt;&lt;br&gt;A) Enable execution from a plan (Home &quot;Execute&quot;, planner toolbar or Summary).&lt;br&gt;B) Or upload a PDF / spreadsheet / JSON / text at PoCs &gt; New PoC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="90" width="270" height="150" as="geometry"/></mxCell>
<mxCell id="b5" value="&lt;b&gt;3  Extract the items (background task)&lt;/b&gt;&lt;br&gt;Planner plan: items are created directly from its tests list, no AI.&lt;br&gt;Any other document: Gemini extracts items, prerequisites and phases, in the UI language." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="670" y="90" width="270" height="150" as="geometry"/></mxCell>
<mxCell id="b6" value="&lt;b&gt;4  Traffic-light classification, per item&lt;/b&gt;&lt;br&gt;Validated procedure? &gt; green.&lt;br&gt;Confirmed before in the history? &gt; green.&lt;br&gt;Web research (Gemini + Google Search) &gt; yellow or red, with sources." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="990" y="90" width="270" height="150" as="geometry"/></mxCell>
<mxCell id="b7" value="&lt;b&gt;5  Execute the PoC (PoC page)&lt;/b&gt;&lt;br&gt;Status and result per item, sessions, dated notes, attachments, day script. A person can override any flag." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="990" y="320" width="270" height="130" as="geometry"/></mxCell>
<mxCell id="b8" value="&lt;b&gt;6  Report&lt;/b&gt;&lt;br&gt;Session e-mail summary and executive summary (Gemini, to copy or edit), HTML export, presentation and day script, in the language of the screen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="670" y="320" width="270" height="130" as="geometry"/></mxCell>
<mxCell id="b9" value="&lt;b&gt;Guided draft (yellow items)&lt;/b&gt;&lt;br&gt;Gemini researches and writes a step-by-step procedure, saved as a DRAFT, invisible to matching until a person runs it and marks it validated." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="990" y="520" width="270" height="130" as="geometry"/></mxCell>
<mxCell id="b10" value="&lt;b&gt;Knowledge base&lt;/b&gt;&lt;br&gt;Validated procedures (with section embeddings) and the anonymous history of confirmed results." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1310" y="190" width="250" height="120" as="geometry"/></mxCell>
<mxCell id="b11" value="&lt;b&gt;Promote an attachment&lt;/b&gt;&lt;br&gt;A written step-by-step attached to an item becomes a validated procedure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1310" y="400" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
