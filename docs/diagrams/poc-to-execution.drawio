<mxCell id="c6" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="70" as="sourcePoint"/><mxPoint x="375" y="1768" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c7" value="Classification service (API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c8" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="70" as="sourcePoint"/><mxPoint x="565" y="1768" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c9" value="Database (pgvector)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c10" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="70" as="sourcePoint"/><mxPoint x="755" y="1768" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c11" value="Gemini" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c12" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="70" as="sourcePoint"/><mxPoint x="945" y="1768" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c13" value="Runs automatically for each new item after the extraction, and on demand: &quot;Classify&quot; on&lt;br&gt;an item, &quot;Classify items without a flag&quot;, or &quot;Re-evaluate&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="107" y="96" width="536" height="40" as="geometry"/></mxCell>
<mxCell id="c14" value="Embedding of the item text" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="164" as="sourcePoint"/><mxPoint x="945" y="164" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c15" value="Vector search, top 5&lt;br&gt;sections of VALIDATED&lt;br&gt;procedures, restricted to&lt;br&gt;the item's category code (no&lt;br&gt;filter if the category has&lt;br&gt;none)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="272" as="sourcePoint"/><mxPoint x="755" y="272" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c16" value="Confirm: does the step-by-step actually solve the item?&lt;br&gt;Pick the candidate." style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="354" as="sourcePoint"/><mxPoint x="945" y="354" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c17" value="GREEN: links the procedure;&lt;br&gt;justification in the UI&lt;br&gt;language" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="420" as="sourcePoint"/><mxPoint x="755" y="420" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c18" value="The page shows &quot;just follow it&quot; with a link to the&lt;br&gt;procedure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="107" y="442" width="346" height="40" as="geometry"/></mxCell>
<mxCell id="c19" value="Vector search in the&lt;br&gt;anonymous history (PoC and&lt;br&gt;RFI items already confirmed)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="560" as="sourcePoint"/><mxPoint x="755" y="560" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c20" value="Confirm the match" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="598" as="sourcePoint"/><mxPoint x="945" y="598" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c21" value="GREEN by history: fixed&lt;br&gt;anonymous justification&lt;br&gt;(never says which customer&lt;br&gt;or PoC)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="678" as="sourcePoint"/><mxPoint x="755" y="678" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c22" value="Research with Google Search grounding: is it feasible? is&lt;br&gt;it explicitly unsupported?" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="752" as="sourcePoint"/><mxPoint x="945" y="752" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c23" value="Second call classifies the research (structured answer;&lt;br&gt;grounding cannot be combined with it)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="804" as="sourcePoint"/><mxPoint x="945" y="804" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c24" value="RED only with explicit&lt;br&gt;evidence it is not&lt;br&gt;supported; YELLOW if there&lt;br&gt;is evidence of feasibility&lt;br&gt;or none (&quot;low confidence&quot;).&lt;br&gt;Saves sources and model." style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="912" as="sourcePoint"/><mxPoint x="755" y="912" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c25" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="473" y="294" width="564" height="640" as="geometry"/></mxCell>
<mxCell id="c26" value="alt [a candidate section really covers the item (Gemini confirms)]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="473" y="294" width="408" height="20" as="geometry"/></mxCell>
<mxCell id="c27" style="endArrow=none;dashed=1;html=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="473" y="490" as="sourcePoint"/><mxPoint x="1037" y="490" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c28" value="else [no procedure; the shared history has an equivalent confirmed item]" style="text;html=1;fontSize=10;fontStyle=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="477" y="491" width="444" height="16" as="geometry"/></mxCell>
<mxCell id="c29" style="endArrow=none;dashed=1;html=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="473" y="696" as="sourcePoint"/><mxPoint x="1037" y="696" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c30" value="else [neither]" style="text;html=1;fontSize=10;fontStyle=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="477" y="697" width="96" height="16" as="geometry"/></mxCell>
<mxCell id="c31" value="Every classification stores: flag, auto or manual,&lt;br&gt;justification (tagged with its language), sources,&lt;br&gt;procedure link, model." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="487" y="948" width="346" height="54" as="geometry"/></mxCell>
<mxCell id="c32" value="Item with its flag; the page&lt;br&gt;polls until every item has&lt;br&gt;one" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="1058" as="sourcePoint"/><mxPoint x="375" y="1058" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c33" value="Overrides the flag, the&lt;br&gt;justification and the linked&lt;br&gt;procedure" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="1154" as="sourcePoint"/><mxPoint x="375" y="1154" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c34" value="PATCH /api/pocs/&lt;id&gt;/itens/&lt;&lt;br&gt;item&gt;/classificacao" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="1206" as="sourcePoint"/><mxPoint x="565" y="1206" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c35" value="Saved as manual; the typed&lt;br&gt;text is tagged with the&lt;br&gt;screen language" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="1272" as="sourcePoint"/><mxPoint x="755" y="1272" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c36" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="93" y="1080" width="564" height="214" as="geometry"/></mxCell>
<mxCell id="c37" value="opt [A person disagrees]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="93" y="1080" width="156" height="20" as="geometry"/></mxCell>
<mxCell id="c38" value="&quot;Generate guided draft with&lt;br&gt;AI&quot; (manual, can take over a&lt;br&gt;minute)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="1382" as="sourcePoint"/><mxPoint x="375" y="1382" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c39" value="POST /api/pocs/&lt;id&gt;/itens/&lt;i&lt;br&gt;tem&gt;/gerar-rascunho" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="1434" as="sourcePoint"/><mxPoint x="565" y="1434" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c40" value="Research, then write a step-by-step procedure shaped to the&lt;br&gt;PoC (customer, scope, technical parameters), in the screen&lt;br&gt;language" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="1500" as="sourcePoint"/><mxPoint x="945" y="1500" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c41" value="Procedure as DRAFT (AI-&lt;br&gt;generated) linked to the&lt;br&gt;item. Not used for matching." style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="1566" as="sourcePoint"/><mxPoint x="755" y="1566" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c42" value="After running it successfully the person clicks &quot;Mark as validated&quot; (POST&lt;br&gt;/api/procedimentos/&lt;id&gt;/validar). Only then does it turn future items green. The AI&lt;br&gt;never validates itself." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="107" y="1588" width="536" height="54" as="geometry"/></mxCell>
<mxCell id="c43" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="93" y="1308" width="944" height="346" as="geometry"/></mxCell>
<mxCell id="c44" value="opt [Yellow item without a procedure]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="93" y="1308" width="234" height="20" as="geometry"/></mxCell>
<mxCell id="c45" value="Viewing in another language: justification and item&lt;br&gt;texts are translated on demand and cached with a hash&lt;br&gt;of the original (edits or re-evaluation refresh them).&lt;br&gt;The database keeps the original." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="297" y="1668" width="346" height="68" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
