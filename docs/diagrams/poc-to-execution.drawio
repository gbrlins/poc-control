<mxCell id="e9" value="reuse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="b10" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="validated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b11" target="b10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" value="run + validate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="b9" target="b11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="t3" value="PoC: from the plan to the execution (overview). Detailed sequences are on the next pages." style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1300" height="32" as="geometry"/></mxCell>
<mxCell id="t4" value="Blue = browser, green = server (API + background tasks), purple = Gemini, yellow = stored knowledge. Nothing leaves the browser until &quot;Enable execution&quot; or a PoC upload." style="text;html=1;fontSize=11;fontStyle=0;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="1400" height="22" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram name="1 Plan in the planner (browser)" id="page2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1290" pageHeight="1440" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
