<mxCell id="c5" value="Planner (browser)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="24" width="150" height="46" as="geometry"/></mxCell>
