<mxfile host="app.diagrams.net" type="device">
<diagram name="0 Overview" id="page1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="b3" value="&lt;b&gt;1  Create the RFI&lt;/b&gt;&lt;br&gt;RFIs &gt; New RFI: choose files (PDF, Word, spreadsheet, text) or paste text. Nothing is uploaded until &quot;Create RFI&quot;; a progress bar shows the upload." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="270" height="140" as="geometry"/></mxCell>
<mxCell id="b4" value="&lt;b&gt;2  Extract requirements (background task)&lt;/b&gt;&lt;br&gt;Gemini reads each document and keeps only the leaf requirements in the portfolio areas, with the tender's own numbering. Skips administrative and legal clauses." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="90" width="270" height="140" as="geometry"/></mxCell>
<mxCell id="b5" value="&lt;b&gt;3  Evaluate each requirement, automatically&lt;/b&gt;&lt;br&gt;1. Validated internal procedure? &gt; Meets.&lt;br&gt;2. Confirmed before in the history? &gt; Meets.&lt;br&gt;3. Web research (Gemini + Google Search) &gt; one of 4 verdicts, with sources." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="670" y="90" width="270" height="140" as="geometry"/></mxCell>
<mxCell id="b6" value="&lt;b&gt;Verdict per item&lt;/b&gt;&lt;br&gt;Meets / Partially meets / Does not meet / No evidence, with a justification and sources. Always a suggestion." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="990" y="90" width="270" height="140" as="geometry"/></mxCell>
<mxCell id="b7" value="&lt;b&gt;4  Review (RFI page)&lt;/b&gt;&lt;br&gt;Filters, change a verdict by hand, re-evaluate one, all or pending, add or remove documents, see sources, copy URLs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="990" y="300" width="270" height="130" as="geometry"/></mxCell>
<mxCell id="b8" value="&lt;b&gt;5  Export and share&lt;/b&gt;&lt;br&gt;HTML and XLSX in the language of the screen; download the original documents." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1310" y="300" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="b9" value="&lt;b&gt;Knowledge base&lt;/b&gt;&lt;br&gt;Validated procedures and the anonymous history. A verdict set to &quot;Meets&quot; by hand also feeds the history." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="990" y="480" width="270" height="110" as="geometry"/></mxCell>
<mxCell id="b10" value="&lt;b&gt;Failures&lt;/b&gt;&lt;br&gt;If extraction fails the RFI is marked error: &quot;Try again&quot; re-extracts only documents that produced no items. A restarted server interrupts a run; &quot;Re-evaluate pending&quot; resumes it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="300" width="270" height="150" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="requirements" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="manual &quot;Meets&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="b7" target="b9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="reuse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="b9" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="b4" target="b10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="t3" value="RFI analysis: from the tender documents to a verdict per requirement (overview)." style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1300" height="32" as="geometry"/></mxCell>
<mxCell id="t4" value="An RFI is a first triage against the SUSE portfolio, independent of any PoC. Detailed sequences are on the next pages." style="text;html=1;fontSize=11;fontStyle=0;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="1400" height="22" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram name="1 Create the RFI and extract the requirements" id="page2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1290" pageHeight="1520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="SA (user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="24" width="150" height="46" as="geometry"/></mxCell>
