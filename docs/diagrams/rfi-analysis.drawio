<mxCell id="c45" value="opt [Delete]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="93" y="1504" width="84" height="20" as="geometry"/></mxCell>
<mxCell id="c46" value="Not covered by this page: an RFI is independent of any PoC. Turning RFI items into PoC items is an idea, not a&lt;br&gt;feature." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="107" y="1760" width="726" height="40" as="geometry"/></mxCell>
