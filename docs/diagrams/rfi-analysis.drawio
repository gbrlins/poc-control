<mxCell id="c5" value="Evaluation service (API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="24" width="150" height="46" as="geometry"/></mxCell>
