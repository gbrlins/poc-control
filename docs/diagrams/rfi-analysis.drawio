<mxCell id="c5" value="Web app (RFI page)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c6" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="70" as="sourcePoint"/><mxPoint x="375" y="1832" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c7" value="poc-control API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c8" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="70" as="sourcePoint"/><mxPoint x="565" y="1832" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c9" value="Database + files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c10" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="70" as="sourcePoint"/><mxPoint x="755" y="1832" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c11" value="Gemini" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c12" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="70" as="sourcePoint"/><mxPoint x="945" y="1832" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c13" value="Opens an existing RFI from&lt;br&gt;RFIs (list, filter by owner&lt;br&gt;or date) or from Home" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="140" as="sourcePoint"/><mxPoint x="375" y="140" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c14" value="GET /api/rfis/&lt;id&gt;?lang=orig&lt;br&gt;(instant) then ?lang=&lt;screen&lt;br&gt;language&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="206" as="sourcePoint"/><mxPoint x="565" y="206" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c15" value="Translate the justification and the category of items that&lt;br&gt;need it, in batches" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="288" as="sourcePoint"/><mxPoint x="945" y="288" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c16" value="Cached with a hash of the&lt;br&gt;original; edits or re-&lt;br&gt;evaluation refresh it. The&lt;br&gt;tender's requirement text is&lt;br&gt;never translated." style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="382" as="sourcePoint"/><mxPoint x="755" y="382" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c17" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="283" y="228" width="754" height="176" as="geometry"/></mxCell>
<mxCell id="c18" value="alt [viewing in a language other than the text was written in]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="283" y="228" width="384" height="20" as="geometry"/></mxCell>
<mxCell id="c19" value="Items with verdicts,&lt;br&gt;justifications and source&lt;br&gt;tables" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="462" as="sourcePoint"/><mxPoint x="375" y="462" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c20" value="Changes the verdict and the&lt;br&gt;justification of an item" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="544" as="sourcePoint"/><mxPoint x="375" y="544" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c21" value="PATCH&lt;br&gt;/api/rfis/&lt;id&gt;/itens/&lt;item&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="596" as="sourcePoint"/><mxPoint x="565" y="596" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c22" value="Saved as manual (text tagged&lt;br&gt;with the screen language). A&lt;br&gt;manual &quot;Meets&quot; also feeds&lt;br&gt;the shared history." style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="676" as="sourcePoint"/><mxPoint x="755" y="676" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c23" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="93" y="484" width="754" height="214" as="geometry"/></mxCell>
<mxCell id="c24" value="opt [A person disagrees with a verdict]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="93" y="484" width="246" height="20" as="geometry"/></mxCell>
<mxCell id="c25" value="&quot;Re-evaluate&quot; on one item,&lt;br&gt;&quot;Re-evaluate all&quot; (manual&lt;br&gt;verdicts kept unless&lt;br&gt;included) or &quot;Re-evaluate&lt;br&gt;pending&quot;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="814" as="sourcePoint"/><mxPoint x="375" y="814" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c26" value="POST&lt;br&gt;.../itens/&lt;item&gt;/reavaliar&lt;br&gt;or  POST .../reavaliar" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="880" as="sourcePoint"/><mxPoint x="565" y="880" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c27" value="Same evaluation as page 2,&lt;br&gt;in the background for the&lt;br&gt;whole RFI" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="946" as="sourcePoint"/><mxPoint x="755" y="946" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c28" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="93" y="712" width="944" height="256" as="geometry"/></mxCell>
<mxCell id="c29" value="opt [Re-evaluate]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="93" y="712" width="114" height="20" as="geometry"/></mxCell>
<mxCell id="c30" value="&quot;Try again&quot; on a failed&lt;br&gt;extraction" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="1042" as="sourcePoint"/><mxPoint x="375" y="1042" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c31" value="POST .../reextrair (only&lt;br&gt;documents that produced no&lt;br&gt;items)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="1108" as="sourcePoint"/><mxPoint x="565" y="1108" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c32" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="93" y="982" width="564" height="148" as="geometry"/></mxCell>
<mxCell id="c33" value="opt [Failures]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="93" y="982" width="96" height="20" as="geometry"/></mxCell>
<mxCell id="c34" value="Sorts the source table,&lt;br&gt;copies URLs" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="1204" as="sourcePoint"/><mxPoint x="375" y="1204" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c35" value="POST .../fontes/resolver&lt;br&gt;(older RFIs with Google&lt;br&gt;redirect links)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="1270" as="sourcePoint"/><mxPoint x="565" y="1270" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c36" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="93" y="1144" width="564" height="148" as="geometry"/></mxCell>
<mxCell id="c37" value="opt [Sources]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="93" y="1144" width="90" height="20" as="geometry"/></mxCell>
<mxCell id="c38" value="Exports the RFI or downloads&lt;br&gt;an original document" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="1336" as="sourcePoint"/><mxPoint x="375" y="1336" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c39" value="GET /api/rfis/&lt;id&gt;/export,&lt;br&gt;export.xlsx (?lang=),&lt;br&gt;documentos/&lt;id&gt;/download" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="1402" as="sourcePoint"/><mxPoint x="565" y="1402" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c40" value="HTML or XLSX from read-only&lt;br&gt;translated views; the&lt;br&gt;database is never changed by&lt;br&gt;an export" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="1482" as="sourcePoint"/><mxPoint x="375" y="1482" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c41" value="Delete (owner only): sees&lt;br&gt;what will disappear and&lt;br&gt;types the title" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="1578" as="sourcePoint"/><mxPoint x="375" y="1578" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c42" value="GET .../exclusao (preview),&lt;br&gt;then DELETE with {confirmar:&lt;br&gt;title}" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="1644" as="sourcePoint"/><mxPoint x="565" y="1644" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c43" value="Removes the rows and the&lt;br&gt;uploads folder; an audit row&lt;br&gt;keeps only the title and&lt;br&gt;counts" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="1724" as="sourcePoint"/><mxPoint x="755" y="1724" as="targetPoint"/></mxGeometry></mxCell>
