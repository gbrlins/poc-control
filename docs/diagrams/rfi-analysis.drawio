<mxCell id="c8" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="70" as="sourcePoint"/><mxPoint x="565" y="1438" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c9" value="Gemini" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c10" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="70" as="sourcePoint"/><mxPoint x="755" y="1438" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c11" value="Web app (polling)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c12" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="70" as="sourcePoint"/><mxPoint x="945" y="1438" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c13" value="Checks the cancel flag; records progress &quot;evaluating k of&lt;br&gt;K&quot; and the current step" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="156" as="sourcePoint"/><mxPoint x="565" y="156" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c14" value="avaliar_item_rfi(item,&lt;br&gt;language)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="208" as="sourcePoint"/><mxPoint x="375" y="208" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c15" value="Embedding of the requirement text" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="246" as="sourcePoint"/><mxPoint x="755" y="246" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c16" value="Step 1: internal procedures first (cheapest, and the&lt;br&gt;strongest evidence)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="297" y="268" width="346" height="40" as="geometry"/></mxCell>
<mxCell id="c17" value="Vector search in VALIDATED&lt;br&gt;procedures, top 5,&lt;br&gt;restricted to the item's&lt;br&gt;category code (no filter if&lt;br&gt;none)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="392" as="sourcePoint"/><mxPoint x="565" y="392" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c18" value="Confirm the match" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="460" as="sourcePoint"/><mxPoint x="755" y="460" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c19" value="Verdict MEETS, procedure&lt;br&gt;linked (&quot;See internal&lt;br&gt;procedure&quot;), no web sources" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="526" as="sourcePoint"/><mxPoint x="565" y="526" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c20" value="Step 2: vector search in the&lt;br&gt;history (PoC and RFI items&lt;br&gt;already confirmed)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="614" as="sourcePoint"/><mxPoint x="565" y="614" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c21" value="Confirm the match" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="652" as="sourcePoint"/><mxPoint x="755" y="652" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c22" value="Verdict MEETS with a fixed&lt;br&gt;anonymous justification&lt;br&gt;(never names a customer, PoC&lt;br&gt;or tender)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="732" as="sourcePoint"/><mxPoint x="565" y="732" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c23" value="Step 3: research with Google Search grounding: which SUSE&lt;br&gt;product meets this requirement?" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="806" as="sourcePoint"/><mxPoint x="755" y="806" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c24" value="Second call classifies the research (structured, no&lt;br&gt;grounding)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="858" as="sourcePoint"/><mxPoint x="755" y="858" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c25" value="Verdict MEETS, PARTIALLY&lt;br&gt;MEETS, DOES NOT MEET or NO&lt;br&gt;EVIDENCE (never claims&lt;br&gt;either way without proof);&lt;br&gt;justification in the UI&lt;br&gt;language; sources" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="966" as="sourcePoint"/><mxPoint x="565" y="966" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c26" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="283" y="414" width="564" height="574" as="geometry"/></mxCell>
<mxCell id="c27" value="alt [a candidate covers it (Gemini confirms)]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="283" y="414" width="282" height="20" as="geometry"/></mxCell>
<mxCell id="c28" style="endArrow=none;dashed=1;html=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="283" y="544" as="sourcePoint"/><mxPoint x="847" y="544" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c29" value="else [no, but the shared history has an equivalent confirmed answer]" style="text;html=1;fontSize=10;fontStyle=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="287" y="545" width="420" height="16" as="geometry"/></mxCell>
<mxCell id="c30" style="endArrow=none;dashed=1;html=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="283" y="750" as="sourcePoint"/><mxPoint x="847" y="750" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c31" value="else [neither]" style="text;html=1;fontSize=10;fontStyle=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="287" y="751" width="96" height="16" as="geometry"/></mxCell>
<mxCell id="c32" value="Source links: the redirect&lt;br&gt;URLs of the grounding are&lt;br&gt;resolved to the real page&lt;br&gt;addresses" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="1060" as="sourcePoint"/><mxPoint x="565" y="1060" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c33" value="Polls: each item appears with its verdict as soon as it is&lt;br&gt;saved" style="html=1;endArrow=open;endFill=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="1112" as="sourcePoint"/><mxPoint x="565" y="1112" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c34" value="A never-evaluated item&lt;br&gt;becomes NO EVIDENCE with the&lt;br&gt;error as justification (no&lt;br&gt;endless &quot;processing&quot;); an&lt;br&gt;already evaluated item keeps&lt;br&gt;its verdict" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="1250" as="sourcePoint"/><mxPoint x="565" y="1250" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c35" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="283" y="1134" width="374" height="138" as="geometry"/></mxCell>
<mxCell id="c36" value="opt [the Gemini call fails]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="283" y="1134" width="174" height="20" as="geometry"/></mxCell>
<mxCell id="c37" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="93" y="96" width="944" height="1190" as="geometry"/></mxCell>
<mxCell id="c38" value="loop [for each new item, in order]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="93" y="96" width="216" height="20" as="geometry"/></mxCell>
<mxCell id="c39" value="Final status: ready (or error if everything failed);&lt;br&gt;progress cleared" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="1330" as="sourcePoint"/><mxPoint x="565" y="1330" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c40" value="Cancel: the &quot;Cancel&quot; button sets a flag checked between items; the call in progress finishes first. Items not reached are marked &quot;No evidence&quot; with a&lt;br&gt;message asking to re-evaluate. Restarting the API container is different: on startup the whole RFI is marked error (&quot;interrupted by a server&lt;br&gt;restart&quot;); items already evaluated keep their verdict and &quot;Re-evaluate pending&quot; resumes the rest." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="107" y="1352" width="916" height="54" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
