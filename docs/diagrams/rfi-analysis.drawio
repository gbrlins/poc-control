<mxCell id="c5" value="Web app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c6" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="70" as="sourcePoint"/><mxPoint x="375" y="1500" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c7" value="poc-control API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c8" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="70" as="sourcePoint"/><mxPoint x="565" y="1500" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c9" value="Background task (in the API process)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c10" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="70" as="sourcePoint"/><mxPoint x="755" y="1500" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c11" value="Gemini" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c12" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="70" as="sourcePoint"/><mxPoint x="945" y="1500" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c13" value="Database + files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="24" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c14" style="endArrow=none;dashed=1;html=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135" y="70" as="sourcePoint"/><mxPoint x="1135" y="1500" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c15" value="Home &gt; &quot;Analyze RFI&quot; opens the list of existing RFIs&lt;br&gt;(/rfis); &quot;New RFI&quot; there opens the form (/rfis/new)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="107" y="96" width="346" height="40" as="geometry"/></mxCell>
<mxCell id="c16" value="Title and organization&lt;br&gt;(optional: Gemini suggests&lt;br&gt;them); chooses PDF / Word /&lt;br&gt;XLSX / CSV / text files, or&lt;br&gt;pastes text" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="220" as="sourcePoint"/><mxPoint x="375" y="220" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c17" value="Choosing files does NOT upload them. They are held in&lt;br&gt;the page (kept if you navigate away and back, lost on&lt;br&gt;reload; the browser asks before closing). A note says&lt;br&gt;so." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="107" y="242" width="346" height="68" as="geometry"/></mxCell>
<mxCell id="c18" value="Clicks &quot;Create RFI&quot;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="338" as="sourcePoint"/><mxPoint x="375" y="338" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c19" value="POST /api/rfis (multipart,&lt;br&gt;XHR with a progress bar;&lt;br&gt;header X-UI-Lang)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="404" as="sourcePoint"/><mxPoint x="565" y="404" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c20" value="Prepares each file: Word&lt;br&gt;and spreadsheets are&lt;br&gt;converted to text, plain&lt;br&gt;text is kept as is, a PDF&lt;br&gt;is kept as a PDF (Gemini&lt;br&gt;reads it natively in the&lt;br&gt;task)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="434" as="sourcePoint"/><mxPoint x="565" y="540" as="targetPoint"/><Array as="points"><mxPoint x="715" y="434"/><mxPoint x="715" y="540"/></Array></mxGeometry></mxCell>
<mxCell id="c21" value="Creates the RFI (status: extracting, owner = you); files saved under uploads/rfis/&lt;id&gt;/" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="570" as="sourcePoint"/><mxPoint x="1135" y="570" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c22" value="Schedules processar_rfi&lt;br&gt;(documents, language, your&lt;br&gt;Gemini key)" style="html=1;endArrow=open;endFill=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="636" as="sourcePoint"/><mxPoint x="755" y="636" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c23" value="201 with the RFI id" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="674" as="sourcePoint"/><mxPoint x="375" y="674" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c24" value="Shows &quot;upload complete,&lt;br&gt;queuing the analysis&quot;,&lt;br&gt;then opens /rfis/&lt;id&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="704" as="sourcePoint"/><mxPoint x="375" y="754" as="targetPoint"/><Array as="points"><mxPoint x="525" y="704"/><mxPoint x="525" y="754"/></Array></mxGeometry></mxCell>
<mxCell id="c25" value="GET /api/rfis/&lt;id&gt;?lang=..." style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="814" as="sourcePoint"/><mxPoint x="565" y="814" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c26" value="Status, progress (reading n&lt;br&gt;of N, evaluating k of K),&lt;br&gt;items so far" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="880" as="sourcePoint"/><mxPoint x="375" y="880" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c27" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="283" y="768" width="374" height="134" as="geometry"/></mxCell>
<mxCell id="c28" value="loop [page polls while extracting]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="283" y="768" width="216" height="20" as="geometry"/></mxCell>
<mxCell id="c29" value="Checks the cancel flag; records progress &quot;reading&quot;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="962" as="sourcePoint"/><mxPoint x="1135" y="962" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c30" value="Extract the leaf&lt;br&gt;requirements in the&lt;br&gt;portfolio areas&lt;br&gt;(virtualization, Kubernetes,&lt;br&gt;storage, security,&lt;br&gt;observability, OS, edge,&lt;br&gt;AI), keeping the tender's&lt;br&gt;numbering; also title,&lt;br&gt;organization, process number" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="1112" as="sourcePoint"/><mxPoint x="945" y="1112" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c31" value="Creates the items (original wording in description, never&lt;br&gt;rewritten); category tagged with the UI language; one&lt;br&gt;commit per document so items appear as they are ready" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="1178" as="sourcePoint"/><mxPoint x="1135" y="1178" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c32" value="A document that fails is recorded with the reason and&lt;br&gt;the others continue." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="677" y="1200" width="346" height="40" as="geometry"/></mxCell>
<mxCell id="c33" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="663" y="916" width="564" height="336" as="geometry"/></mxCell>
<mxCell id="c34" value="loop [for each document]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="663" y="916" width="156" height="20" as="geometry"/></mxCell>
<mxCell id="c35" value="Status: error, with the reason per document" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="1312" as="sourcePoint"/><mxPoint x="1135" y="1312" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c36" value="Goes on to evaluate the&lt;br&gt;new items (page 2)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="1364" as="sourcePoint"/><mxPoint x="755" y="1400" as="targetPoint"/><Array as="points"><mxPoint x="905" y="1364"/><mxPoint x="905" y="1400"/></Array></mxGeometry></mxCell>
<mxCell id="c37" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="663" y="1266" width="564" height="148" as="geometry"/></mxCell>
<mxCell id="c38" value="alt [every document failed]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=10;fontStyle=1;align=left;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="663" y="1266" width="174" height="20" as="geometry"/></mxCell>
<mxCell id="c39" style="endArrow=none;dashed=1;html=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="663" y="1330" as="sourcePoint"/><mxPoint x="1227" y="1330" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c40" value="else [at least one document worked]" style="text;html=1;fontSize=10;fontStyle=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="667" y="1331" width="222" height="16" as="geometry"/></mxCell>
<mxCell id="c41" value="Add documents later: POST /api/rfis/&lt;id&gt;/documentos (progress bar, same task). Remove a&lt;br&gt;document: its items go too, with a warning for manually set verdicts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="297" y="1428" width="536" height="40" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
